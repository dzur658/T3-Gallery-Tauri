{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    {
      "identifier": "fs:allow-picture-read-recursive",
      "allow": [{ 
        "path": "$PICTURE/**",
        "path": "$HOME/Pictures",
        "path": "$HOME/Pictures/**"
        }]
    }
  ]
}
