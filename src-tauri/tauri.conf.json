{
  "$schema": "../../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "VLM Gallery",
  "version": "0.1.0",
  "identifier": "com.dzur658.dev",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "VLM Gallery",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost http://asset.localhost https://huggingface.co https://cdn-lfs.huggingface.co https://cas-bridge.xethub.hf.co https://cdn.jsdelivr.net https://us.aws.cdn.hf.co",
        "img-src": "'self' blob: data: http://asset.localhost",
        "script-src": "'self' 'wasm-unsafe-eval' blob:",
        "worker-src": "'self' blob:"
      },
      "assetProtocol": {
        "enable": true,
        "scope": ["$PICTURE/**", "$HOME/Pictures", "$HOME/Pictures/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
